# Copy this file to backend/backend/.env and replace the placeholder values.

DB_URL=jdbc:postgresql://your-db-host:5432/your-db-name
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password

# Choose one Firebase option:
# 1. Path to the JSON file
FIREBASE_CREDENTIALS=./firebase-adminsdk.json
# 2. Or base64-encoded JSON content so no local file is needed
FIREBASE_CREDENTIALS_JSON_BASE64=

OPENAI_API_KEY=your-openai-api-key

# Optional overrides
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:4200
APP_CHAT_ENABLED=true
MCP_SERVER_ORIGIN=http://localhost:8000
MCP_SERVER_ENDPOINT=/mcp
