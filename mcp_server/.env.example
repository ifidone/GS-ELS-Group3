MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
LOG_LEVEL=INFO

# Optional shared secret for MCP HTTP access.
# When set, clients must send:
# Authorization: Bearer <MCP_AUTH_TOKEN>
# or X-MCP-Token: <MCP_AUTH_TOKEN>
MCP_AUTH_TOKEN=
# Safety override for public binds without token (not recommended).
ALLOW_INSECURE_PUBLIC_BIND=false

BACKEND_BASE_URL=http://localhost:8080
BACKEND_TIMEOUT_SECONDS=10

# DB configuration (required when tools use direct DB queries):
DB_URL=jdbc:postgresql://host:5432/dbname
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
# Optional single DSN alternative:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
